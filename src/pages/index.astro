---
import Base from '../layouts/Base.astro';
import {
  categories, categoryMeta, traditions, quickResets, techniques,
  techniquesByTradition,
} from '../data/content';
import { traditionTile } from '../data/images';
import { url } from '../utils';
import { Image } from 'astro:assets';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';
import StillWater from '../components/StillWater.astro';
import ShaderHero from '../components/ShaderHero.astro';
import Grasshopper from '../components/Grasshopper.astro';
import TraditionSelector from '../components/TraditionSelector.astro';
import TraditionBookmarks from '../components/TraditionBookmarks.astro';
import TechniqueCard from '../components/TechniqueCard.astro';
---
<Base title="Traditions — ancient practices, catalogued">
  {/* Full-bleed marquee reel above the nav bar. */}
  <div class="topbar" slot="topbar">
    <a href="#five-minute-reset" class="topbar-tag">
      <Icon name="timer" size={14} /><span>5-min reset</span>
    </a>
    <div class="reset-marquee">
      <div class="reset-marquee-track">
        {[false, true].map((dup) =>
          quickResets.map((t) => (
            <a
              href={url(`technique/${t.id}`)}
              class="reset-marquee-item"
              aria-hidden={dup ? 'true' : undefined}
              tabindex={dup ? -1 : undefined}
            >
              {t.title}<span class="reset-marquee-dot">✦</span>
            </a>
          )),
        )}
      </div>
    </div>
  </div>

  <!-- ============ PRACTICES (3-Column Bookmarks Grid) ============ -->
  <section class="section wrap bookmarks" id="practices" data-reveal>
    <p class="eyebrow bookmarks__label">Practices — ancient techniques, catalogued</p>
    <TraditionBookmarks />
  </section>

  <!-- ============ 5-MINUTE RESET GRID ============ -->
  <section class="section wrap" id="five-minute-reset" data-reveal style="margin-top: clamp(1.4rem, 3.5vw, 2.4rem);">
    <div class="section-head reset-head" style="margin-bottom: clamp(1.4rem, 3vw, 2rem); align-items: baseline;">
      <div>
        <p class="eyebrow bookmarks__label" style="margin-bottom: 0;"><Icon name="timer" size={13} style="vertical-align: -1px; margin-right: 4px;" /> 5-Minute Reset — quick practices</p>
      </div>
      <button class="reset-expand" id="reset-expand" aria-expanded="false" aria-controls="reset-grid">
        Show all {quickResets.length}
      </button>
    </div>

    <div class="card-grid reset-grid" id="reset-grid">
      {quickResets.map((t) => <TechniqueCard technique={t} />)}
    </div>

    <script is:inline>
      // Collapse immediately (inline, pre-paint). Without JS all cards just show.
      (() => {
        const grid = document.getElementById('reset-grid');
        const btn = document.getElementById('reset-expand');
        if (!grid || !btn) return;
        const total = grid.children.length;
        grid.classList.add('is-collapsed');
        btn.addEventListener('click', () => {
          const collapsed = grid.classList.toggle('is-collapsed');
          btn.setAttribute('aria-expanded', String(!collapsed));
          btn.textContent = collapsed ? `Show all ${total}` : 'Show fewer';
        });
      })();
    </script>
  </section>

  <!-- ============ TRADITIONS (Row-by-Row index with hover previews) ============ -->
  <section class="section wrap traditions" id="traditions" data-reveal style="margin-top: clamp(1.4rem, 3.5vw, 2.4rem); --reveal-delay: 80ms">
    <p class="eyebrow bookmarks__label">Traditions — origins & heritage</p>
    <ul class="trad-index" id="trad-index">
      {traditions.map((tr) => {
        const img = traditionTile(tr.id);
        const items = techniquesByTradition(tr.id);
        return (
          <li class="trad-item">
            <div class="trad-row">
              <a href={url(`tradition/${tr.id}`)} class="trad-row-main">
                <Emblem id={tr.id} size={20} class="trad-row-emblem" />
                <span class="trad-row-name">{tr.name}</span>
                <span class="trad-row-go"><Icon name="arrow-right" size={16} /></span>
              </a>
              <span class="trad-row-region">{tr.region}</span>
              <button
                type="button"
                class="trad-row-toggle"
                aria-expanded="false"
                aria-controls={`trad-panel-${tr.id}`}
                aria-label={`${items.length} practices from ${tr.name}`}
              >
                <span class="trad-row-toggle-label">
                  {items.length}<span class="trad-row-toggle-word"> practices</span>
                </span>
                <Icon name="chevron-down" size={15} class="trad-row-chev" />
              </button>
              {img && (
                <span class="trad-row-thumb" aria-hidden="true">
                  <Image src={img} alt="" widths={[480]} sizes="300px" quality={68} loading="lazy" />
                </span>
              )}
            </div>
            <div class="trad-panel" id={`trad-panel-${tr.id}`}>
              <div class="trad-panel-inner">
                <div class="card-grid card-grid--tight">
                  {items.map((t) => (
                    <article class="tech-card">
                      <a href={url(`technique/${t.id}`)} class="tech-card-link">
                        <h4 class="tech-card-title">{t.title}</h4>
                        <p class="tech-card-desc">{t.description}</p>
                      </a>
                    </article>
                  ))}
                </div>
              </div>
            </div>
          </li>
        );
      })}
    </ul>

    <!-- Hover preview overlay -->
    <div class="workprev" id="workprev" aria-hidden="true"></div>
  </section>

  <StillWater />
</Base>

<style is:global>
  /* Local styling overrides to build the web-studio dashboard visual environment */
  .main {
    padding-top: 0 !important;
  }

  /* Section definitions */
  .bookmarks {
    padding-top: clamp(1.4rem, 3.5vw, 2.4rem);
    padding-bottom: clamp(1.4rem, 3.5vw, 2.4rem);
  }
  .bookmarks__label { 
    margin-bottom: clamp(0.9rem, 2.5vw, 1.4rem); 
    font-family: var(--font-mono); 
    font-size: 0.62rem; 
    letter-spacing: 0.28em; 
    text-transform: uppercase; 
    color: var(--text-faint);
    text-align: left;
  }

  /* Shared buttons */
  .btn {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.85rem 1.4rem;
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.82rem; letter-spacing: 0.06em;
    border: 1px solid var(--border-strong);
    color: var(--text);
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), background 0.25s var(--ease);
    position: relative; overflow: hidden;
    cursor: pointer;
  }
  .btn:hover { transform: translateY(-2px); border-color: transparent; }
  
  .btn-primary { border-color: transparent; color: #fff; font-weight: 600; z-index: 1; }
  .btn-primary::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--spectrum); }
  .btn-primary:hover { transform: translateY(-2px) scale(1.02); }
  .btn-ghost:hover { background: var(--bg-sunken); }

  /* Stagger animation for hero loader contents */
  .launch__inner > * { opacity: 0; animation: launch-in 0.75s var(--ease) forwards; }
  .launch__inner > *:nth-child(1) { animation-delay: 0ms; }
  .launch__inner > *:nth-child(2) { animation-delay: 90ms; }
  .launch__inner > *:nth-child(3) { animation-delay: 170ms; }
  @keyframes launch-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .launch__inner > * { animation: none; opacity: 1; }
  }

  /* Traditions list inline components */
  .tech-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s, background 0.2s;
  }
  .tech-card:hover {
    border-color: var(--accent);
    background: var(--bg-sunken);
  }
  .tech-card-link {
    display: block;
    padding: 1.1rem;
    text-decoration: none;
    color: inherit;
    text-align: left;
  }
  .tech-card-title {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
    font-family: var(--font-sans);
    font-weight: 600;
  }
  .tech-card-desc {
    font-size: 0.84rem;
    color: var(--text-soft);
    line-height: 1.45;
  }
</style>

<script is:inline>
  // Shuffle tradition rows on every visit (inline and pre-paint)
  (() => {
    const list = document.getElementById('trad-index');
    if (!list) return;
    const rows = [...list.children];
    for (let i = rows.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [rows[i], rows[j]] = [rows[j], rows[i]];
    }
    list.append(...rows);
  })();
</script>

<script is:inline>
  // Accordion for traditions list
  (() => {
    const list = document.getElementById('trad-index');
    if (!list) return;
    const items = [...list.querySelectorAll('.trad-item')];
    const setOpen = (item, open) => {
      item.classList.toggle('is-open', open);
      item.querySelector('.trad-row-toggle')?.setAttribute('aria-expanded', String(open));
    };
    list.addEventListener('click', (e) => {
      const btn = e.target.closest('.trad-row-toggle');
      if (!btn) return;
      const item = btn.closest('.trad-item');
      const opening = btn.getAttribute('aria-expanded') !== 'true';
      items.forEach((i) => setOpen(i, false));
      if (!opening) return;
      setOpen(item, true);
      document.getElementById('workprev')?.classList.remove('show');
      requestAnimationFrame(() => {
        const top = item.getBoundingClientRect().top;
        if (top < 70) {
          window.scrollTo({
            top: window.scrollY + top - 96,
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
          });
        }
      });
    });
  })();
</script>

<script is:inline>
  // Hover preview cursor follower (Pointer-fine only)
  (() => {
    const prev = document.getElementById('workprev');
    if (!prev || !matchMedia('(pointer: fine)').matches) return;
    document.querySelectorAll('.trad-row').forEach((row) => {
      const img = row.querySelector('.trad-row-thumb img');
      if (!img) return;
      const open = () => row.closest('.trad-item')?.classList.contains('is-open');
      row.addEventListener('pointerenter', () => {
        if (open()) return;
        const clone = img.cloneNode(true);
        clone.loading = 'eager';
        prev.replaceChildren(clone);
        prev.classList.add('show');
      });
      row.addEventListener('pointermove', (e) => {
        if (open()) return;
        prev.style.left = e.clientX + 'px';
        prev.style.top = e.clientY + 'px';
      });
      row.addEventListener('pointerleave', () => prev.classList.remove('show'));
    });
  })();
</script>
