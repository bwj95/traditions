---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import {
  categories, categoryMeta, categoryCounts, traditions, quickResets, techniques,
  techniquesByCategory,
} from '../data/content';
import { traditionTile } from '../data/images';
import { url } from '../utils';
import TechniqueCard from '../components/TechniqueCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';
import StillWater from '../components/StillWater.astro';
---
<Base>
  {/* Full-bleed reel above the nav bar. Each item links to its technique; the
      second copy exists only for the seamless loop, so it's hidden from AT and
      the tab order. */}
  <div class="topbar" slot="topbar">
    <a href="#five-minute-reset" class="topbar-tag">
      <Icon name="timer" size={14} /><span>5-min reset</span>
    </a>
    <div class="reset-marquee">
      <div class="reset-marquee-track">
        {[false, true].map((dup) =>
          quickResets.map((t) => (
            <a
              href={url(`technique/${t.id}`)}
              class="reset-marquee-item"
              aria-hidden={dup ? 'true' : undefined}
              tabindex={dup ? -1 : undefined}
            >
              {t.title}<span class="reset-marquee-dot">✦</span>
            </a>
          )),
        )}
      </div>
    </div>
  </div>

  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <h1>Time-tested ways to feel <em>better</em>.</h1>
    <p class="hero-sub">
      {techniques.length} practices drawn from {traditions.length} of the world's
      wellness traditions — for the mind, the body, the breath, and the table.
      Browse by what you need, or by where it comes from.
    </p>
  </section>

  {/* Category tiles pin & stack as you scroll (workbench Stack layout), and
      each one opens to reveal its practices without leaving the page.
      The tile is a <div>, not an <a>: a toggle button can't legally live
      inside a link, so the label and "Explore" carry the navigation. */}
  <section class="section">
    <h2 class="section-title">Browse by category</h2>
    <div class="cat-grid cat-grid--stack" id="cat-stack">
      {categories.map((c) => {
        const meta = categoryMeta[c];
        const items = techniquesByCategory(c);
        return (
          <div class="cat-tile" style={`--badge-hue:${meta.hue}`}>
            <CategoryIcon category={c} size={26} class="cat-tile-icon" />
            <span class="cat-tile-count">{categoryCounts[c]}</span>
            <h3><a href={url(c)} class="cat-tile-head">{meta.label}</a></h3>
            <p>{meta.blurb}</p>
            <div class="cat-tile-actions">
              <button
                type="button"
                class="cat-tile-toggle"
                aria-expanded="false"
                aria-controls={`cat-panel-${c}`}
              >
                <span data-open="Hide practices">Show {items.length} practices</span>
                <Icon name="chevron-down" size={16} class="cat-tile-chev" />
              </button>
              <a href={url(c)} class="cat-tile-go">Explore <Icon name="arrow-right" size={16} /></a>
            </div>
            <div class="cat-tile-panel" id={`cat-panel-${c}`}>
              <div class="cat-tile-panel-inner">
                <div class="card-grid card-grid--tight">
                  {items.map((t) => <TechniqueCard technique={t} />)}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <script is:inline>
      // Accordion: one category open at a time. 48 cards across four tiles is a
      // very long page otherwise, and the sticky stack has nowhere to put them.
      (() => {
        const stack = document.getElementById('cat-stack');
        if (!stack) return;
        const tiles = [...stack.querySelectorAll('.cat-tile')];
        const setOpen = (tile, open) => {
          const btn = tile.querySelector('.cat-tile-toggle');
          tile.classList.toggle('is-open', open);
          btn?.setAttribute('aria-expanded', String(open));
        };
        stack.addEventListener('click', (e) => {
          const btn = e.target.closest('.cat-tile-toggle');
          if (!btn) return;
          const tile = btn.closest('.cat-tile');
          const opening = btn.getAttribute('aria-expanded') !== 'true';
          tiles.forEach((t) => setOpen(t, false));
          if (opening) setOpen(tile, true);
          // Sticky tiles can't hold a 20-card list — one taller than the
          // viewport pins and the tiles below slide over its contents. While
          // anything is open the whole stack drops to normal flow.
          stack.classList.toggle('has-open', opening);
          if (!opening) return;
          // Keep the tile you just opened under the thumb instead of letting
          // the reflow shove it off screen.
          requestAnimationFrame(() => {
            const top = tile.getBoundingClientRect().top;
            if (top < 70 || top > window.innerHeight * 0.5) {
              window.scrollTo({
                top: window.scrollY + top - 96,
                behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
              });
            }
          });
        });
      })();
    </script>
  </section>

  {/* Collapsed grid; the button reveals all of them. The marquee that used to
      sit here now runs full-bleed in the topbar, so it isn't duplicated. */}
  <section class="section" id="five-minute-reset">
    <div class="section-head reset-head">
      <div>
        <h2 class="section-title"><Icon name="timer" size={20} /> 5-Minute Reset</h2>
        <p class="section-note">Quick practices you can finish in about five minutes.</p>
      </div>
      <button class="reset-expand" id="reset-expand" aria-expanded="false" aria-controls="reset-grid">
        Show all {quickResets.length}
      </button>
    </div>

    <div class="card-grid reset-grid" id="reset-grid">
      {quickResets.map((t) => <TechniqueCard technique={t} />)}
    </div>

    <script is:inline>
      // Collapse immediately (inline, pre-paint). Without JS all cards just show.
      (() => {
        const grid = document.getElementById('reset-grid');
        const btn = document.getElementById('reset-expand');
        if (!grid || !btn) return;
        const total = grid.children.length;
        grid.classList.add('is-collapsed');
        btn.addEventListener('click', () => {
          const collapsed = grid.classList.toggle('is-collapsed');
          btn.setAttribute('aria-expanded', String(!collapsed));
          btn.textContent = collapsed ? `Show all ${total}` : 'Show fewer';
        });
      })();
    </script>
  </section>

  {/* Traditions as a numbered editorial index (workbench Index layout);
      a floating photo preview follows the cursor over each row. */}
  <section class="section">
    <h2 class="section-title">Browse by tradition</h2>
    {/* <ul>, not <ol>: the order is shuffled per visit, so there's no rank to
        number. No tradition gets to be permanently first. */}
    <ul class="trad-index" id="trad-index">
      {traditions.map((tr) => {
        const img = traditionTile(tr.id);
        return (
          <li>
            <a href={url(`tradition/${tr.id}`)} class="trad-row">
              <Emblem id={tr.id} size={20} class="trad-row-emblem" />
              <span class="trad-row-name">{tr.name}</span>
              <span class="trad-row-region">{tr.region}</span>
              <span class="trad-row-go"><Icon name="arrow-right" size={16} /></span>
              {img && (
                <span class="trad-row-thumb" aria-hidden="true">
                  <Image src={img} alt="" widths={[480]} sizes="300px" quality={68} loading="lazy" />
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <script is:inline>
      // Shuffle on every visit. Inline and immediately after the list so it
      // runs before first paint — a shuffle in DOMContentLoaded would show the
      // build-time order first and visibly reorder itself.
      (() => {
        const list = document.getElementById('trad-index');
        if (!list) return;
        const rows = [...list.children];
        for (let i = rows.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1)); // Fisher-Yates
          [rows[i], rows[j]] = [rows[j], rows[i]];
        }
        list.append(...rows); // append moves existing nodes; no clone, no relisten
      })();
    </script>

    <div class="workprev" id="workprev" aria-hidden="true"></div>

    <script is:inline>
      // Floating hover preview — clones the row's hidden photo and follows the
      // cursor. Mouse-only (pointer: fine); touch simply navigates.
      (() => {
        const prev = document.getElementById('workprev');
        if (!prev || !matchMedia('(pointer: fine)').matches) return;
        document.querySelectorAll('.trad-row').forEach((row) => {
          const img = row.querySelector('.trad-row-thumb img');
          if (!img) return;
          row.addEventListener('pointerenter', () => {
            const clone = img.cloneNode(true);
            clone.loading = 'eager'; // source sits in a display:none span
            prev.replaceChildren(clone);
            prev.classList.add('show');
          });
          row.addEventListener('pointermove', (e) => {
            prev.style.left = e.clientX + 'px';
            prev.style.top = e.clientY + 'px';
          });
          row.addEventListener('pointerleave', () => prev.classList.remove('show'));
        });
      })();
    </script>
  </section>

  {/* Closing beat: browse, then rest. */}
  <StillWater />
</Base>
