---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { techniques, getTechnique, getTradition } from '../../data/content';
import { techniqueImage } from '../../data/images';
import { url } from '../../utils';
import CategoryBadge from '../../components/CategoryBadge.astro';
import DifficultyBadge from '../../components/DifficultyBadge.astro';
import Emblem from '../../components/Emblem.astro';
import Icon from '../../components/Icon.astro';

export function getStaticPaths() {
  return techniques.map((t) => ({ params: { id: t.id } }));
}

const { id } = Astro.params;
const technique = getTechnique(id)!;
const trad = getTradition(technique.tradition);
const img = techniqueImage(id);
---
<Base title={`${technique.title} — Traditions`} description={technique.description}>
  <a href={trad ? url(`tradition/${trad.id}`) : url()} class="back-link">
    <Icon name="arrow-left" size={16} /> {trad ? trad.name : 'Home'}
  </a>

  <header class="page-header">
    <div class="badge-row">
      {technique.category.map((c) => <CategoryBadge category={c} />)}
      <DifficultyBadge level={technique.difficulty} />
    </div>
    <h1>{technique.title}</h1>
    <p class="page-lede">{technique.description}</p>
    <div class="tech-facts">
      <span class="meta-item"><Icon name="clock" size={15} /> {technique.duration}</span>
      {trad && (
        <span class="meta-item">
          <Emblem id={trad.id} size={16} class="trad-inline-emblem" />
          From <a href={url(`tradition/${trad.id}`)} class="inline-link">{trad.name}</a>
        </span>
      )}
    </div>
  </header>

  {img && (
    <div class="tech-hero-img">
      <Image src={img} alt={technique.title} widths={[640, 960, 1280]} quality={68}
        sizes="(max-width: 820px) 100vw, 820px" loading="eager" fetchpriority="high" />
    </div>
  )}

  <section class="steps-section">
    <h2 class="section-title">How to practice</h2>
    <ol class="steps-list">
      {technique.steps.map((step, i) => (
        <li>
          <span class="step-num">{i + 1}</span>
          <span class="step-text">{step}</span>
        </li>
      ))}
    </ol>
  </section>

  <div class="detail-cols">
    <section>
      <h2 class="section-title">Benefits</h2>
      <ul class="benefit-tags">
        {technique.benefits.map((b) => <li class="benefit-tag">{b}</li>)}
      </ul>
    </section>
    <section>
      <h2 class="section-title">Origin</h2>
      <blockquote class="origin-note">
        <Icon name="info" size={16} />
        <span>{technique.origin}</span>
      </blockquote>
    </section>
  </div>
</Base>
