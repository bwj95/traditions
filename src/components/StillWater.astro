---
/*
 * StillWater — a window onto deep water. Skim the cursor across it, tap it, or
 * let it rain; ripples spread outward and fade away into the dark.
 *
 * This is a real 2D wave simulation, not expanding CSS circles. Two height
 * buffers hold the water surface; each frame every cell becomes the average of
 * its four neighbours minus its own previous height, damped slightly — the
 * discrete form of the wave equation. That one line is what gives genuine
 * interference and decay for free; faked rings can't do any of it.
 *
 * The rim is an ABSORBING boundary (see buildDamping) — ripples fade out as
 * though the water continued past the frame instead of bouncing back.
 *
 * Rendering refracts rather than draws: the local height *gradient* offsets
 * which source pixel each output pixel samples, so the artwork underneath
 * genuinely bends. The gradient doubles as a specular term for the glints.
 *
 * The backdrop is a slowly WANDERING ocean gradient — each stop drifts in hue
 * and lightness on its own incommensurate period, and the gradient axis swings,
 * so light appears to move across the water without ever looping. It's
 * repainted at 5Hz, not per frame (buildSource redraws shapes and pulls a full
 * getImageData). The drawn current striations and the veined caustic layer both
 * went: ripples now read as glints across that gradient, which is quieter.
 *
 * Moving the cursor cuts a shallow wake (see skim) — a hand trailed through
 * water rather than a line of dropped stones.
 *
 * Crest glints are tinted per column across the site's terracotta → ochre →
 * sage spectrum, so the pool catches the brand accent. The rain keeps a
 * 4s-in / 6s-out breathing cycle (6 breaths a minute) and the gradient's
 * lightness swells with it.
 *
 * The backing store is deliberately a third of CSS resolution and upscaled by
 * the browser — a ninth of the pixels to push, and the resulting softness reads
 * as depth. DPR is irrelevant for the same reason.
 *
 * Canvas + JS (not experimental CSS) so it works in every engine. Decorative:
 * canvas is aria-hidden and the "Drop a stone" button gives keyboard and
 * assistive-tech users the same interaction. Under prefers-reduced-motion
 * there's no rain, no drift and no idle loop — it renders still, and only a
 * deliberate tap stirs it, running just long enough to settle again.
 */
import Icon from './Icon.astro';
import { url } from '../utils';

interface Props {
  /** Fill the viewport on its own page instead of sitting in a card. */
  full?: boolean;
}
const { full = false } = Astro.props;
---

<section class:list={['water-section', full ? 'water-section--full' : 'section']} id="still-water">
  {!full && (
    <div class="section-head">
      <h2 class="section-title">Still water</h2>
      <p class="section-note">
        A place to do nothing in particular. Touch the surface and watch it settle —
        the oldest instruction in half these traditions. The rain keeps a slow
        four-in, six-out rhythm; breathe along with it if you like.
      </p>
    </div>
  )}

  <div class:list={['water-frame', full && 'water-frame--full']} id="water-frame">
    <canvas class="water-canvas" id="water-canvas" aria-hidden="true"></canvas>

    {full && (
      <div class="water-overlay" id="water-overlay">
        <h1>Still water</h1>
        <p>
          Nothing to finish here. The rain keeps a slow four-in, six-out rhythm —
          breathe along with it, or just watch the light move.
        </p>
      </div>
    )}

    <p class="water-hint" id="water-hint" aria-hidden="true">touch the water</p>
  </div>

  <div class:list={['water-foot', full && 'water-foot--full']}>
    <button type="button" class="water-btn" id="water-drop">Drop a stone</button>
    {full
      ? <a href={url()} class="water-link"><Icon name="arrow-left" size={15} /> Back to the guide</a>
      : <a href={url('still')} class="water-link">Open it full screen <Icon name="arrow-right" size={15} /></a>}
  </div>
</section>

<script is:inline>
  (() => {
    const frame = document.getElementById('water-frame');
    const canvas = document.getElementById('water-canvas');
    const hint = document.getElementById('water-hint');
    const button = document.getElementById('water-drop');
    if (!frame || !canvas || !canvas.getContext) return;

    const ctx = canvas.getContext('2d', { alpha: false });
    const reduceMq = matchMedia('(prefers-reduced-motion: reduce)');
    const darkMq = matchMedia('(prefers-color-scheme: dark)');

    // Sim runs at 1/SCALE of CSS pixels; the browser upscales the canvas.
    //
    // SCALE/STEPS/DAMP are one tuning problem, not three knobs.
    //
    // Expanding this scheme gives u_new = 2u - u_old + 0.5*laplacian, i.e. a
    // Courant number of 1/sqrt(2), so the front advances ~0.707 cells per step,
    // not one — about 4.2 css px per frame here, ~255px/s, roughly how a real
    // pond spreads. (Measured: the far probe sits 260 cells out and lights up at
    // 3077ms, = 0.704 cells/step. Nice when the arithmetic and the browser
    // agree.) DAMP sets how far a ripple gets before dying: amplitude halves
    // every ~ln(0.5)/ln(DAMP) steps, so 0.995 buys ~138 steps. At the first
    // pass (SCALE 2 / 1 step / 0.985) ripples crawled and faded inside ~300px,
    // which on a 1000px pool read as a dud puddle.
    const SCALE = 3;
    const STEPS = 2;      // sim steps per frame
    const DAMP = 0.995;   // <1 or energy never leaves; too low and ripples thud out
    const REFRACT = 2.6;  // how far the height gradient bends the source
    // Higher than it was: with the caustics and striations gone there's almost
    // no texture left for REFRACT to bend, so the specular term is essentially
    // the whole visible ripple now.
    const SPEC = 21;
    // Peak |height| below which reduced-motion stops. Must be a PEAK, not a
    // mean: one stone's energy averaged over ~47k cells is ~0.014, so a mean
    // test declared the pool settled on the frame the stone landed and the
    // ripple never animated at all.
    const SETTLED = 0.03;

    const TINT = 0.85;    // 0 = white glints, 1 = fully spectrum-coloured
    // Skim: a soft continuous wake under a moving cursor. Small and wide, not
    // a stone — a stone is a point impulse and reads as a struck ring.
    const SKIM = 1.9;
    // Coherent breathing: 4s in, 6s out = 6 breaths/min, the rate most of the
    // breath practices in this catalogue land on. The rain keeps that time.
    const INHALE = 4000, EXHALE = 6000, BREATH = INHALE + EXHALE;

    let w = 0, h = 0;
    let cur, prv, src, img, out;
    let tintR, tintG, tintB, damping;
    let lastPaint = -1e9; // when the drifting gradient was last repainted
    let raf = 0, visible = false;
    let px = -1e4, py = -1e4, pointerIn = false; // cursor, in sim coords
    let skimX = -1, skimY = -1;                  // last position a wake was cut from
    let breathT0 = 0, breathPhase = -1, breathEnv = 0.5;

    const readVar = (name, fallback) =>
      getComputedStyle(frame).getPropertyValue(name).trim() || fallback;

    /* ---------- absorbing boundary (sponge layer) ----------
       The edge cells are never integrated, which pins them at zero — a hard
       wall, so every ripple bounced back and the pool rang like a tray. Instead
       of one scalar DAMP, each cell gets its own damping value: DAMP in the
       middle, ramping down to ABSORB_MIN across a band at the rim. A wave
       entering the band is attenuated to almost nothing before it can reach the
       wall, and to nothing again on the way back, so it reads as water carrying
       on past the frame rather than slapping into it.

       Per-cell cost is unchanged — it was already one multiply by DAMP. */
    const ABSORB_MIN = 0.86; // damping right at the rim
    function buildDamping() {
      damping = new Float32Array(w * h);
      const band = Math.max(10, Math.min(30, Math.round(Math.min(w, h) * 0.22)));
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const d = Math.min(x, y, w - 1 - x, h - 1 - y); // cells to nearest edge
          let k = DAMP;
          if (d < band) {
            // Quadratic ramp: gentle at the inner lip so the layer itself
            // doesn't become a reflecting discontinuity.
            const t = (band - d) / band;
            k = DAMP - (DAMP - ABSORB_MIN) * t * t;
          }
          damping[y * w + x] = k;
        }
      }
    }

    /* ---------- colour helpers ---------- */
    const rgbHsl = ([r, g, b]) => {
      r /= 255; g /= 255; b /= 255;
      const mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2;
      if (mx === mn) return [0, 0, l * 100];
      const dd = mx - mn;
      const sat = dd / (l > 0.5 ? 2 - mx - mn : mx + mn);
      const hh = mx === r ? (g - b) / dd + (g < b ? 6 : 0)
               : mx === g ? (b - r) / dd + 2
               : (r - g) / dd + 4;
      return [hh * 60, sat * 100, l * 100];
    };
    const hslCss = (h2, s2, l2) =>
      `hsl(${h2.toFixed(1)} ${Math.max(0, Math.min(100, s2)).toFixed(1)}% ${Math.max(0, Math.min(100, l2)).toFixed(1)}%)`;
    const hexRgb = (s) => {
      const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(s.trim());
      return m ? [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16)] : [255, 255, 255];
    };
    function buildTint() {
      tintR = new Float32Array(w); tintG = new Float32Array(w); tintB = new Float32Array(w);
      const A = hexRgb(readVar('--water-tint-a', '#a8543a'));
      const B = hexRgb(readVar('--water-tint-b', '#c2913c'));
      const C = hexRgb(readVar('--water-tint-c', '#6b7d5a'));
      for (let x = 0; x < w; x++) {
        const t = w > 1 ? x / (w - 1) : 0;
        const [p, q, k] = t < 0.5 ? [A, B, t * 2] : [B, C, (t - 0.5) * 2];
        const r = p[0] + (q[0] - p[0]) * k;
        const g = p[1] + (q[1] - p[1]) * k;
        const b = p[2] + (q[2] - p[2]) * k;
        // Normalise against luminance so tinting shifts hue without changing how
        // bright a crest reads, then ease back toward neutral by TINT.
        const lum = (r + g + b) / 3 || 1;
        tintR[x] = 1 + (r / lum - 1) * TINT;
        tintG[x] = 1 + (g / lum - 1) * TINT;
        tintB[x] = 1 + (b / lum - 1) * TINT;
      }
    }

    /* ---------- the artwork the ripples distort ---------- */
    function buildSource(ms) {
      if (!w || !h) return;
      const off = document.createElement('canvas');
      off.width = w; off.height = h;
      const c = off.getContext('2d');

      // Each stop wanders in hue and lightness on its own slow period, so the
      // gradient never repeats exactly and never visibly loops. The periods are
      // deliberately incommensurate. The breath rides on top as a small swell.
      const T = (ms || 0) / 1000;
      const swell = 0.94 + 0.11 * breathEnv;
      const wander = (hex, i) => {
        const [hh, ss, ll] = rgbHsl(hexRgb(hex));
        const hz = [41, 67, 53][i], lz = [97, 73, 111][i];
        return hslCss(
          (hh + Math.sin((T / hz) * Math.PI * 2) * 13 + 360) % 360,
          ss * (1 + Math.sin((T / lz) * Math.PI * 2) * 0.12),
          ll * swell * (1 + Math.sin((T / lz) * Math.PI * 2 + 1.1) * 0.16),
        );
      };
      const a = wander(readVar('--water-a', '#24505c'), 0);
      const b = wander(readVar('--water-b', '#123240'), 1);
      const d = wander(readVar('--water-c', '#071a25'), 2);
      const glow = readVar('--water-glow', '#6fb3ad');

      // The gradient axis swings too, so the light seems to move across the
      // water instead of sitting in one corner.
      const ax = w * (0.25 + Math.sin((T / 83) * Math.PI * 2) * 0.5);
      const ay = h * (0.06 + Math.sin((T / 59) * Math.PI * 2) * 0.06);
      const g = c.createLinearGradient(ax, ay, w - ax, h);
      g.addColorStop(0, a); g.addColorStop(0.55, b); g.addColorStop(1, d);
      c.fillStyle = g; c.fillRect(0, 0, w, h);

      // The last of the daylight, all of it from above and none of it reaching
      // the floor — that vertical falloff is most of what makes it read as
      // depth rather than a dark pond.
      c.globalAlpha = 0.34;
      for (const [gx, gy, gr] of [[0.28, -0.08, 0.55], [0.72, -0.12, 0.45], [0.5, 0.02, 0.32]]) {
        const rg = c.createRadialGradient(w * gx, h * gy, 0, w * gx, h * gy, Math.max(w, h) * gr);
        rg.addColorStop(0, glow); rg.addColorStop(1, 'transparent');
        c.fillStyle = rg; c.fillRect(0, 0, w, h);
      }
      c.globalAlpha = 1;

      // Things down there. Deliberately unresolved: soft dark masses with no
      // readable edge, so you register a shape without ever identifying it.
      // Anything crisper stops being ominous and starts being a logo.
      const deep = readVar('--water-deep', '#04101a');
      c.fillStyle = deep;
      const shapes = [
        [0.20, 0.74, 0.30, 0.20], [0.62, 0.86, 0.42, 0.24],
        [0.86, 0.52, 0.22, 0.18], [0.42, 0.30, 0.18, 0.12],
      ];
      for (const [sx, sy, sw, sh] of shapes) {
        c.globalAlpha = 0.30;
        c.beginPath();
        // Lumpy ellipse: radius wobbles with angle so nothing reads as a circle.
        for (let a2 = 0; a2 <= Math.PI * 2 + 0.01; a2 += 0.25) {
          const wob = 1 + Math.sin(a2 * 3 + sx * 9) * 0.18 + Math.sin(a2 * 5 + sy * 7) * 0.10;
          const px = w * sx + Math.cos(a2) * w * sw * 0.5 * wob;
          const py = h * sy + Math.sin(a2) * h * sh * 1.5 * wob;
          a2 ? c.lineTo(px, py) : c.moveTo(px, py);
        }
        c.closePath();
        c.fill();
      }

      // Kelp — slow vertical strands rising out of the dark.
      c.strokeStyle = deep;
      for (let i = 0; i < 9; i++) {
        const bx = w * (0.06 + (i / 9) * 0.92) + Math.sin(i * 5.1) * w * 0.03;
        const top = h * (0.30 + ((i * 37) % 40) / 100);
        c.globalAlpha = 0.26;
        c.lineWidth = Math.max(1.5, w / 130) * (0.6 + ((i * 13) % 7) / 10);
        c.beginPath();
        for (let y = h + 2; y > top; y -= 3) {
          const k = (h - y) / h;
          const px = bx + Math.sin(k * 5.5 + i * 2.3) * w * 0.035 * k;
          y > h ? c.moveTo(px, y) : c.lineTo(px, y);
        }
        c.stroke();
      }
      c.globalAlpha = 1;

      src = c.getImageData(0, 0, w, h).data;
      if (out) out.set(src); // seed the 1px border the render loop never writes
    }

    function resize() {
      const cw = frame.clientWidth, ch = frame.clientHeight;
      if (!cw || !ch) return;
      const nw = Math.max(32, Math.round(cw / SCALE));
      const nh = Math.max(32, Math.round(ch / SCALE));
      if (nw === w && nh === h) return;
      w = nw; h = nh;
      canvas.width = w; canvas.height = h;
      cur = new Float32Array(w * h);
      prv = new Float32Array(w * h);
      img = ctx.createImageData(w, h);
      out = img.data;
      buildDamping();
      buildTint();
      buildSource(performance.now());
      render(performance.now());
    }

    /* ---------- wave equation ---------- */
    function step() {
      const W = w;
      for (let y = 1; y < h - 1; y++) {
        const row = y * W;
        for (let x = 1; x < W - 1; x++) {
          const i = row + x;
          prv[i] = ((cur[i - 1] + cur[i + 1] + cur[i - W] + cur[i + W]) * 0.5 - prv[i]) * damping[i];
        }
      }
      const t = cur; cur = prv; prv = t; // new state lands in cur
    }

    function render(t) {
      if (!src) return;
      const W = w, d = out;
      const still = reduceMq.matches;
      const ms = still ? 0 : (t || 0);
      for (let y = 1; y < h - 1; y++) {
        const row = y * W;
        for (let x = 1; x < W - 1; x++) {
          const i = row + x;
          const dx = cur[i - 1] - cur[i + 1];
          const dy = cur[i - W] - cur[i + W];
          // Round, don't truncate: |0 rounds toward zero, so positive and
          // negative offsets quantize in opposite directions and the crests
          // tear into little horizontal steps.
          let sx = x + Math.round(dx * REFRACT);
          let sy = y + Math.round(dy * REFRACT);
          if (sx < 0) sx = 0; else if (sx >= W) sx = W - 1;
          if (sy < 0) sy = 0; else if (sy >= h) sy = h - 1;
          const si = (sy * W + sx) << 2;
          const di = i << 2;
          // Ripples now read purely as glints across the gradient — the veined
          // caustic layer and the drawn currents both went, per "less busy".
          const s = (dx + dy) * SPEC;
          d[di] = src[si] + s * tintR[x];
          d[di + 1] = src[si + 1] + s * tintG[x];
          d[di + 2] = src[si + 2] + s * tintB[x];
          d[di + 3] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);
    }

    /* ---------- disturbances ---------- */
    function drop(cx, cy, radius, strength) {
      const r = Math.max(1, radius | 0);
      for (let y = -r; y <= r; y++) {
        for (let x = -r; x <= r; x++) {
          const dist = Math.sqrt(x * x + y * y);
          if (dist > r) continue;
          const gx = (cx | 0) + x, gy = (cy | 0) + y;
          if (gx < 1 || gy < 1 || gx >= w - 1 || gy >= h - 1) continue;
          // Cosine falloff — a hard-edged disc rings like a struck bell.
          cur[gy * w + gx] += strength * (Math.cos((dist / r) * Math.PI) + 1) * 0.5;
        }
      }
    }

    const atEvent = (e) => {
      const r = frame.getBoundingClientRect();
      return [((e.clientX - r.left) / r.width) * w, ((e.clientY - r.top) / r.height) * h];
    };

    function stir(cx, cy, big) {
      drop(cx, cy, big ? Math.max(5, w / 38) : Math.max(2, w / 110), big ? -5.2 : -1.1);
      start();
    }

    // First touch dismisses the invitation: the hint goes, and on the full page
    // the title recedes so the water has the screen to itself.
    const overlay = document.getElementById('water-overlay');
    /* A hand trailed through water: a shallow, wide depression that follows the
       cursor and leaves a wake behind it. Deliberately NOT stir() — that's a
       point impulse and reads as a struck ring.

       Three things keep it from being the twitchy old trail:
        - it runs every frame instead of on a 55ms timer, so it's continuous;
        - the amplitude scales with cursor SPEED, so a resting cursor is silent;
        - the total is divided across the segment walked, so a fast flick cuts a
          longer, fainter wake rather than a harder one. */
    function skim() {
      if (!pointerIn || reduceMq.matches) { skimX = -1; return; }
      if (skimX < 0) { skimX = px; skimY = py; return; }
      const dx = px - skimX, dy = py - skimY;
      const dist = Math.sqrt(dx * dx + dy * dy);
      skimX = px; skimY = py;
      if (dist < 0.4) return;                       // resting cursor: no wake
      const steps = Math.min(10, Math.max(1, Math.round(dist / 1.6)));
      const amp = -SKIM * Math.min(1, dist / 7) / steps;
      const rad = Math.max(3, w / 44);
      for (let i = 1; i <= steps; i++) {
        drop(skimX - dx + (dx * i) / steps, skimY - dy + (dy * i) / steps, rad, amp);
      }
    }

    function mark() {
      hint?.classList.add('is-gone');
      overlay?.classList.add('is-gone');
    }

    /* ---------- loop ---------- */
    const settled = () => {
      let peak = 0;
      for (let i = 0; i < cur.length; i += 7) {
        const v = cur[i] < 0 ? -cur[i] : cur[i];
        if (v > peak) { if (v >= SETTLED) return false; peak = v; }
      }
      return peak < SETTLED;
    };

    function tick(t) {
      if (!visible) { raf = 0; return; }
      if (reduceMq.matches && settled()) { raf = 0; render(t); return; }

      if (!reduceMq.matches) {
        // Rain on a breath cycle rather than a random timer: one stone as the
        // inhale starts, one as the exhale starts. Six a minute — slow enough
        // to breathe along with, which is the whole idea.
        const phase = (t - breathT0) % BREATH;
        const inhaling = phase < INHALE;
        const p = inhaling ? phase / INHALE : (phase - INHALE) / EXHALE;
        // Smooth 0→1 rising through the inhale, 1→0 falling through the exhale.
        breathEnv = inhaling
          ? 0.5 - 0.5 * Math.cos(Math.PI * p)
          : 0.5 + 0.5 * Math.cos(Math.PI * p);

        const which = inhaling ? 0 : 1;
        if (which !== breathPhase) {
          breathPhase = which;
          // The exhale drop is the fuller one — the release — but only just:
          // if the inhale beat is much weaker it stops reading as a rhythm at all.
          drop(w * (0.18 + Math.random() * 0.64), h * (0.2 + Math.random() * 0.6),
               Math.max(3, w / 58), inhaling ? -2.5 : -3.2);
        }
      }

      // Repaint the gradient a few times a second rather than every frame:
      // buildSource redraws the shapes and pulls a full getImageData, which is
      // far too much for 60fps. The colours move so slowly that 5Hz steps are
      // invisible.
      if (!reduceMq.matches && t - lastPaint > 200) { lastPaint = t; buildSource(t); }

      skim();
      for (let i = 0; i < STEPS; i++) step();
      render(t);
      raf = requestAnimationFrame(tick);
    }

    function start() {
      if (!raf && visible) raf = requestAnimationFrame(tick);
    }
    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    /* ---------- wiring ---------- */
    frame.addEventListener('pointerdown', (e) => {
      const [x, y] = atEvent(e);
      px = x; py = y; pointerIn = true;
      mark();
      stir(x, y, true);
    });
    // Cursor position only — skim() reads it once a frame and cuts the wake
    // there. Doing it here instead would fire per event, which on a high-rate
    // mouse is several times a frame.
    frame.addEventListener('pointermove', (e) => {
      const [x, y] = atEvent(e);
      px = x; py = y; pointerIn = true;
      if (!reduceMq.matches) start();
    }, { passive: true });
    frame.addEventListener('pointerleave', () => { pointerIn = false; skimX = -1; }, { passive: true });
    // Touch drag skims too. No preventDefault: touch-action already reserves
    // horizontal drags, and swallowing the vertical ones would trap the page on
    // the full-screen version.
    frame.addEventListener('touchmove', (e) => {
      const tp = e.touches[0];
      if (!tp) return;
      const [x, y] = atEvent(tp);
      px = x; py = y; pointerIn = true;
    }, { passive: true });
    frame.addEventListener('touchend', () => { pointerIn = false; skimX = -1; }, { passive: true });

    button?.addEventListener('click', () => {
      mark();
      const x = w * (0.25 + Math.random() * 0.5), y = h * (0.25 + Math.random() * 0.5);
      stir(x, y, true);
    });

    // Only animate while on screen — an idle rAF loop behind the fold is pure
    // battery burn.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        if (visible) { breathT0 = performance.now(); breathPhase = -1; if (!reduceMq.matches) start(); }
        else stop();
      }, { threshold: 0.05 }).observe(frame);
    } else {
      visible = true;
      if (!reduceMq.matches) start();
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (visible && !reduceMq.matches) start();
    });

    if ('ResizeObserver' in window) {
      let deb;
      new ResizeObserver(() => { clearTimeout(deb); deb = setTimeout(resize, 120); }).observe(frame);
    } else {
      window.addEventListener('resize', resize, { passive: true });
    }

    darkMq.addEventListener?.('change', () => { buildTint(); buildSource(performance.now()); render(performance.now()); });
    reduceMq.addEventListener?.('change', () => {
      stop();
      if (!reduceMq.matches && visible) start(); else render(performance.now());
    });
    // Canvas text takes whatever font is loaded at draw time — redraw once
    // Sentient is actually available, or the word renders in Georgia.
    document.fonts?.ready.then(() => { buildSource(performance.now()); render(performance.now()); });

    resize();
  })();
</script>
