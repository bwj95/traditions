---
/*
 * The four category marks (Mind / Body / Breath / Diet), inlined as SVG so we
 * ship no icon-library JS. Lucide-style: 24x24, stroke = currentColor.
 */
interface Props {
  category: 'mind' | 'body' | 'breath' | 'diet';
  size?: number;
  class?: string;
}
const { category, size = 24, class: className } = Astro.props;
const stroke = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.6',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---
<svg viewBox="0 0 24 24" width={size} height={size} class={className} aria-hidden="true" focusable="false" {...stroke}>
  {category === 'mind' && (
    <>
      <path d="M12 5a3 3 0 0 0-3 3 3 3 0 0 0-1 5.8V17a2 2 0 0 0 4 0" />
      <path d="M12 5a3 3 0 0 1 3 3 3 3 0 0 1 1 5.8V17a2 2 0 0 1-4 0" />
      <path d="M12 5v14" />
    </>
  )}
  {category === 'body' && (
    <>
      <circle cx="12" cy="5" r="1.6" />
      <path d="M12 7v6M12 9l-4 2M12 9l4 2M12 13l-3 6M12 13l3 6" />
    </>
  )}
  {category === 'breath' && (
    <path d="M4 8h9a2.5 2.5 0 1 0-2.5-2.5M4 12h13a2.5 2.5 0 1 1-2.5 2.5M4 16h7a2 2 0 1 1-2 2" />
  )}
  {category === 'diet' && (
    <>
      <path d="M11 3C7 3 5 6 5 9c0 4 3 8 6 11 3-3 6-7 6-11 0-3-2-6-6-6Z" />
      <path d="M11 20V8M11 12c-1.5-.5-2.5-1.5-3-3M11 11c1.3-.5 2.2-1.4 2.7-2.7" />
    </>
  )}
</svg>
