---
import '../styles/global.css';
import { categories, categoryMeta, categoryCounts } from '../data/content';
import { url } from '../utils';
import Icon from '../components/Icon.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import LivingBackground from '../components/LivingBackground.astro';
import Grasshopper from '../components/Grasshopper.astro';

interface Props {
  title?: string;
  description?: string;
  /** category id when a category page is active, for nav highlighting */
  activeCategory?: string;
  /** drop the centred wrap + page padding so a page can run edge to edge */
  bleed?: boolean;
}
const {
  title = 'Traditions — a world wellness guide',
  description = 'Nine wellness traditions and their techniques — meditation, movement, breath, and food-as-medicine — honored where they come from.',
  activeCategory,
  bleed = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#6b7d5a" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    {/* Only the two upright variable faces are preloaded — one file each now
        covers every weight. The italic loads on demand where it's used. */}
    <link rel="preload" href={url('fonts/sentient-var.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('fonts/satoshi-var.woff2')} as="font" type="font/woff2" crossorigin />
    {/* Pre-paint: the background mode carries the whole palette with it, so it
        has to land on <html> BEFORE first paint. Setting it after hydration
        would flash the wrong theme on every page load. */}
    <script is:inline>
      (() => {
        let m = 'grass';
        try { const v = localStorage.getItem('traditions-bg'); if (v === 'water' || v === 'grass' || v === 'fire') m = v; } catch {}
        document.documentElement.dataset.bg = m;
      })();
    </script>
  </head>
  <body>
    <div class="app">
      {/* Optional full-bleed strip above the nav — the home page fills it with
          the 5-Minute Reset reel. Scrolls away; only the header sticks. */}
      <slot name="topbar" />
      <header class="site-header">
        <div class="wrap header-inner">
          <a href={url()} class="brand">
            <Icon name="leaf" size={20} class="brand-mark" />
            <span>Traditions</span>
          </a>
          <nav class="cat-nav" aria-label="Sections">
            <a href={url('#practices')} class="cat-link">Practices</a>
            <a href={url('#traditions')} class="cat-link">Traditions</a>
          </nav>
          <form class="search-mini" action={url('search')} method="get" role="search">
            <Icon name="search" size={16} />
            <input type="search" name="q" placeholder="Search practices…" aria-label="Search practices" />
          </form>
          {/* Two explicit options rather than one flipping button — the pressed
              state says which medium you're in without having to guess. */}
          <div class="bg-switch" role="group" aria-label="Background">
            <button type="button" data-bg-set="grass" aria-pressed="true" title="Grass" aria-label="Grass background">
              <Icon name="leaf" size={15} />
            </button>
            <button type="button" data-bg-set="water" aria-pressed="false" title="Water" aria-label="Water background">
              <Icon name="waves" size={15} />
            </button>
            <button type="button" data-bg-set="fire" aria-pressed="false" title="Fire" aria-label="Fire background">
              <Icon name="flame" size={15} />
            </button>
          </div>
          {/* Small screens only — .cat-nav is hidden there, so these links need
              somewhere to live. Bars morph to an X via the aria-expanded state,
              so the CSS reads the same flag assistive tech does. */}
          <button
            type="button"
            class="nav-toggle"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-panel"
            aria-label="Menu"
          >
            <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
          </button>
        </div>

        <div class="nav-panel" id="nav-panel">
          <nav class="wrap nav-panel-inner" aria-label="Sections">
            <a href={url('#practices')} class="nav-panel-link">
              <Icon name="leaf" size={20} class="nav-panel-icon" />
              <span class="nav-panel-label">Practices</span>
            </a>
            <a href={url('#traditions')} class="nav-panel-link">
              <Icon name="map-pin" size={20} class="nav-panel-icon" />
              <span class="nav-panel-label">Traditions</span>
            </a>
            {/* The header search collapses below 560px — this replaces it with
                the full search page rather than duplicating the form. */}
            <a href={url('search')} class="nav-panel-link nav-panel-link--minor">
              <Icon name="search" size={18} class="nav-panel-icon" />
              <span class="nav-panel-label">Search practices</span>
            </a>
            <a href={url('credits')} class="nav-panel-link nav-panel-link--minor">
              <Icon name="info" size={18} class="nav-panel-icon" />
              <span class="nav-panel-label">Image credits</span>
            </a>
            {/* The header switch is hidden below 560px, so it needs a home here
                too — otherwise the background can't be changed on a phone. */}
            <div class="nav-panel-link nav-panel-link--minor nav-panel-bg">
              <span class="nav-panel-label">Background</span>
              <div class="bg-switch" role="group" aria-label="Background">
                <button type="button" data-bg-set="grass" aria-pressed="true" title="Grass" aria-label="Grass background">
                  <Icon name="leaf" size={15} />
                </button>
                <button type="button" data-bg-set="water" aria-pressed="false" title="Water" aria-label="Water background">
                  <Icon name="waves" size={15} />
                </button>
                <button type="button" data-bg-set="fire" aria-pressed="false" title="Fire" aria-label="Fire background">
                  <Icon name="flame" size={15} />
                </button>
              </div>
            </div>
          </nav>
        </div>
      </header>

      <main class:list={[bleed ? 'main main--bleed' : 'wrap main']}>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="wrap">
          <div class="footer-links">
            <a href={url()}>Home</a>
            <a href={url('search')}>Search</a>
            <a href={url('credits')}>Image credits</a>
          </div>
          <p class="disclaimer">
            These practices are shared for educational and wellness purposes and are
            not a substitute for professional medical or mental health care.
          </p>
          <p class="attribution">
            Each practice carries an attribution to the tradition it comes from —
            honoring its origin is part of the point.
          </p>
        </div>
      </footer>
    </div>

    <LivingBackground />

    <script is:inline>
      // Background switch. The buttons only write the attribute + storage;
      // LivingBackground watches <html data-bg> and follows, and the palette
      // rides along on the same attribute in CSS. One source of truth.
      (() => {
        const root = document.documentElement;
        const btns = document.querySelectorAll('[data-bg-set]');
        const sync = () => {
          const m = ['grass','water','fire'].includes(root.dataset.bg) ? root.dataset.bg : 'grass';
          btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.bgSet === m)));
        };
        btns.forEach((b) => b.addEventListener('click', () => {
          root.dataset.bg = b.dataset.bgSet;
          try { localStorage.setItem('traditions-bg', b.dataset.bgSet); } catch {}
          sync();
        }));
        sync();
      })();
    </script>

    <script is:inline>
      // Header behaviour: auto-hide on scroll + the small-screen dropdown menu.
      // They're in one IIFE because they interact — the header must not slide
      // away while the menu hanging off it is open.
      (() => {
        const header = document.querySelector('.site-header');
        if (!header) return;
        const toggle = document.getElementById('nav-toggle');
        const panel = document.getElementById('nav-panel');

        const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';
        const setOpen = (open) => {
          if (!toggle || !panel) return;
          toggle.setAttribute('aria-expanded', String(open));
          panel.classList.toggle('is-open', open);
          // Reappear if the header had auto-hidden before the menu opened.
          if (open) header.classList.remove('is-hidden');
        };

        if (toggle && panel) {
          toggle.addEventListener('click', () => setOpen(!isOpen()));

          // Any link inside the panel closes it. Same-page navigations would
          // rebuild the DOM anyway, but in-page jumps (#five-minute-reset)
          // would otherwise leave the panel covering the target.
          panel.addEventListener('click', (e) => {
            if (e.target.closest('a')) setOpen(false);
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && isOpen()) {
              setOpen(false);
              toggle.focus(); // don't strand focus inside a hidden panel
            }
          });

          document.addEventListener('pointerdown', (e) => {
            if (isOpen() && !header.contains(e.target)) setOpen(false);
          });

          // Past the breakpoint the inline .cat-nav is back and the toggle is
          // display:none — close so focus can't land in a hidden panel.
          matchMedia('(min-width: 721px)').addEventListener('change', (e) => {
            if (e.matches) setOpen(false);
          });
        }

        let lastY = window.scrollY;
        const TH = 8; // px of travel before reacting — ignores scroll jitter
        window.addEventListener('scroll', () => {
          const y = window.scrollY;
          // Scrolling inside the open panel must not retract the header.
          if (isOpen()) { lastY = y; return; }
          if (y < 90) header.classList.remove('is-hidden');
          else if (y > lastY + TH) header.classList.add('is-hidden');
          else if (y < lastY - TH) header.classList.remove('is-hidden');
          lastY = y;
        }, { passive: true });
      })();
    </script>
  </body>
</html>
